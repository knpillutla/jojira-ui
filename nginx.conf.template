server {
  listen 80;
  listen [::]:80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  access_log /var/log/nginx/access.log;
  error_log /var/log/nginx/error.log notice;

  # 1. Forward Auth endpoints to User Service
  location /api/v1/auth {
    proxy_pass https://${CONTAINER_APP_USER_SERVICE_HOST};
    proxy_http_version 1.1;
    proxy_ssl_server_name on;
    proxy_set_header Host ${CONTAINER_APP_USER_SERVICE_HOST};
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 300s;
    proxy_connect_timeout 300s;
  }

  # 2. Forward User endpoints to User Service
  location /api/v1/users {
    proxy_pass https://${CONTAINER_APP_USER_SERVICE_HOST};
    proxy_http_version 1.1;
    proxy_ssl_server_name on;
    proxy_set_header Host ${CONTAINER_APP_USER_SERVICE_HOST};
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 300s;
    proxy_connect_timeout 300s;
  }

  # 3. Forward all API endpoints (/api/v1/search/ai, /api/v1/flights, /api/v1/stays, etc.) to Main Booking API
  location /api {
    proxy_pass https://${CONTAINER_APP_API_HOST};
    proxy_http_version 1.1;
    proxy_ssl_server_name on;
    proxy_set_header Host ${CONTAINER_APP_API_HOST};
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 300s;
    proxy_connect_timeout 300s;
    proxy_send_timeout 300s;
  }

  # 4. Frontend Single Page Application (SPA) Fallback
  location / {
    try_files $uri $uri/ /index.html;
    add_header Cache-Control "public, max-age=300";
  }

  # 5. Static Assets
  location ~* \.(css|js|woff2)$ {
    add_header Cache-Control "no-cache, no-store, must-revalidate";
  }
}
