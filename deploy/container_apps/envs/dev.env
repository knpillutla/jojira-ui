# ==============================================================================
# DEV ENVIRONMENT CONFIGURATION (Serverless Container App Dev Environment)
# ==============================================================================
ENVIRONMENT="dev"
AZURE_SUBSCRIPTION_NAME="JOJIRA_DEV"
AZURE_RESOURCE_GROUP="rg-containerapp-dev"
AZURE_LOCATION="East US"

AZURE_CONTAINER_APP_ENV="cae-jojira-dev-env"
AZURE_ACR_NAME="jojiraserverlessacr"
AZURE_KEYVAULT_NAME="jojiradevcakv"
IMAGE_NAME="jojira-ui"
IMAGE_TAG="dev-latest"

# Service Container App Hostnames
CONTAINER_APP_UI_NAME="app-jojira-ui-dev"
CONTAINER_APP_API_NAME="app-jojira-dev"
CONTAINER_APP_USER_SERVICE_NAME="app-jojira-user-service-dev"
CONTAINER_APP_ORDER_SERVICE_NAME="app-jojira-order-service-dev"
CONTAINER_APP_POSTGRES_NAME="app-jojira-postgres-dev"
CONTAINER_APP_REDIS_NAME="app-jojira-redis-dev"
CONTAINER_APP_RABBITMQ_NAME="app-jojira-rabbitmq-dev"

CONTAINER_APP_API_HOST="app-jojira-dev.mangoglacier-a04733de.eastus.azurecontainerapps.io"
CONTAINER_APP_USER_SERVICE_HOST="app-jojira-user-service-dev.mangoglacier-a04733de.eastus.azurecontainerapps.io"

# Resource & Scaling Limits
CPU="0.25"
MEMORY="0.5Gi"
MIN_REPLICAS="1"
MAX_REPLICAS="10"

# Azure Key Vault Secret References
KEYVAULT_SECRET_GOOGLE_CLIENT_ID="google-client-id"
KEYVAULT_SECRET_GOOGLE_CLIENT_SECRET="google-client-secret"
KEYVAULT_SECRET_GOOGLE_MAPS_API_KEY="google-maps-api-key"
KEYVAULT_SECRET_DUFFEL_API_TOKEN="duffel-api-token"

# Runtime Application Configurations
DEFAULT_ORDER_MODE="instant"
LLM_PROVIDER="openai"
AZURE_KEYVAULT_ENABLED="true"
MAIN_API_URL="https://app-jojira-dev.mangoglacier-a04733de.eastus.azurecontainerapps.io"
USER_SERVICE_URL="https://app-jojira-user-service-dev.mangoglacier-a04733de.eastus.azurecontainerapps.io"
