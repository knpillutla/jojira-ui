# Azure Resource Settings
RESOURCE_GROUP=rg-jojira-dev
LOCATION=eastus
CONTAINER_APP_NAME=ca-jojira-ui-dev
CONTAINER_APP_ENV=cae-jojira-dev
ACR_NAME=crjojiradev
IMAGE_NAME=jojira-ui
IMAGE_TAG=dev-latest

# Azure Key Vault Configuration
KEY_VAULT_NAME=kv-jojiradev
KEYVAULT_SECRET_GOOGLE_CLIENT_ID=google-client-id
KEYVAULT_SECRET_GOOGLE_CLIENT_SECRET=google-client-secret
KEYVAULT_SECRET_GOOGLE_MAPS_API_KEY=google-maps-api-key
KEYVAULT_SECRET_DUFFEL_API_TOKEN=duffel-api-token

# Default Backend Service Endpoints for Container App Nginx / UI runtime
MAIN_API_URL=https://ca-jojira-duffel-dev.eastus.azurecontainerapps.io
USER_SERVICE_URL=https://ca-jojira-user-service-dev.eastus.azurecontainerapps.io
