FROM nginx:1.27-alpine

ENV CONTAINER_APP_USER_SERVICE_NAME=app-jojira-user-service-dev
ENV CONTAINER_APP_API_NAME=app-jojira-dev
ENV GOOGLE_CLIENT_ID=""
ENV GOOGLE_MAPS_API_KEY=""
ENV ENVIRONMENT="dev"

# Copy web application assets
COPY . /usr/share/nginx/html/

# Copy Nginx template and startup script into official Nginx entrypoint hooks
COPY nginx.conf.template /etc/nginx/templates/default.conf.template
COPY deploy/container_apps/40-generate-config.sh /docker-entrypoint.d/40-generate-config.sh
RUN chmod +x /docker-entrypoint.d/40-generate-config.sh

# Remove development / deployment metadata from static web root
RUN rm -rf /usr/share/nginx/html/deploy /usr/share/nginx/html/.git

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
